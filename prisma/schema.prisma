generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AttendeeStatus {
  PENDING
  APPROVED
  HIDDEN
}

enum MeetingOfferStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum UserRole {
  ADMIN
  HOST
}

model Conference {
  id               String     @id @default(cuid())
  slug             String     @unique
  customSubdomain  String?    @unique
  title_ka         String
  description_ka   String
  date             DateTime
  location_ka      String
  coverImageUrl    String?
  websiteUrl       String?
  mapUrl           String?
  agendaHighlights Json?
  speakers         Json?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  attendees        Attendee[]
  hostAssignments  HostConference[]
}

model Attendee {
  id                String         @id @default(cuid())
  conferenceId      String
  fullName          String
  company           String?
  position          String?
  motivation        String?
  phone             String
  linkedinUrl       String
  photoUrl          String?
  sharePhonePublic  Boolean        @default(false)
  consentPublicList Boolean
  status            AttendeeStatus @default(PENDING)
  createdAt         DateTime       @default(now())
  conference        Conference     @relation(fields: [conferenceId], references: [id], onDelete: Cascade)
  receivedOffers    MeetingOffer[] @relation("ReceivedOffers")
  sentOffers        MeetingOffer[] @relation("SentOffers")

  @@index([conferenceId, status])
  @@index([conferenceId, status, consentPublicList, createdAt])
  @@index([conferenceId, consentPublicList, position])
  @@index([fullName])
  @@index([company])
}

model MeetingOffer {
  id                String             @id @default(cuid())
  recipientAttendeeId String
  senderAttendeeId  String?
  senderName        String
  senderContact     String?
  proposedAt        DateTime?
  note              String?
  status            MeetingOfferStatus @default(PENDING)
  createdAt         DateTime           @default(now())
  recipient         Attendee           @relation("ReceivedOffers", fields: [recipientAttendeeId], references: [id], onDelete: Cascade)
  sender            Attendee?          @relation("SentOffers", fields: [senderAttendeeId], references: [id], onDelete: SetNull)

  @@index([recipientAttendeeId, createdAt])
  @@index([senderAttendeeId, createdAt])
  @@index([senderAttendeeId, status, createdAt])
  @@index([senderContact, status, createdAt])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  passwordHash  String?
  role          UserRole  @default(HOST)
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  hostedConferences HostConference[]
}

model HostConference {
  id           String     @id @default(cuid())
  userId       String
  conferenceId String
  createdAt    DateTime   @default(now())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  conference   Conference @relation(fields: [conferenceId], references: [id], onDelete: Cascade)

  @@unique([userId, conferenceId])
  @@index([conferenceId])
}

model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String? @db.Text
  access_token             String? @db.Text
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String? @db.Text
  session_state            String?
  refresh_token_expires_in Int?
  user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
